def push(day, unit, rep, gap, minutes, crit):
    # 容量检查：超出则顺延到最近的有空位的一天
    d = day
    while d <= TOTAL_DAYS:
        if used[d] + minutes <= CAP[d] and blocks[d] < 7:
            used[d] += minutes
            blocks[d] += 1
            rows.append(dict(day=d, unit=unit, rep=rep, gap=gap, minutes=minutes, crit=crit))
            return d
        d += 1
    return None

